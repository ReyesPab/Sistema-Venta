# ============================================
# Environment Variables - AutoParts Pro
# Copia este archivo como .env y llena los valores
# ============================================

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/autoparts_pro

# PostgreSQL (alternativa)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoparts_pro
DB_USER=admin
DB_PASSWORD=your_password
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@autopartspro.com

# SMS (Twilio)
SMS_PROVIDER=twilio
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_PHONE=+1234567890

# Payment - Atlantic
ATLANTIDA_API_KEY=your-atlantida-api-key
ATLANTIDA_SECRET_KEY=your-atlantida-secret-key
ATLANTIDA_WEBHOOK_URL=https://yourdomain.com/api/webhooks/atlantida

# AI Chat (OpenAI)
OPENAI_API_KEY=your-openai-api-key

# File Storage
STORAGE_PROVIDER=local
# Para S3:
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
